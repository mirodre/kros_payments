# Verejná adresa aplikácie (bez lomky na konci)
APP_URL=https://financie.krosdoplnky.sk
# Produkcia: postgres://user:pass@host:5432/financie
# Lokálne bez Postgresu: pglite:./.data/pg  (alebo pglite:memory)
DATABASE_URL=pglite:./.data/pg
# min. 32 znakov: openssl rand -base64 48
SESSION_SECRET=
# 32 bajtov base64: openssl rand -base64 32  (zmena = všetky KROS prepojenia treba obnoviť)
APP_ENCRYPTION_KEY=
AUTH_SERVICE_URL=https://login.krosdoplnky.sk
AUTH_SERVICE_CLIENT_ID=
AUTH_SERVICE_CLIENT_SECRET=
AUTH_SERVICE_REDIRECT_URI=https://financie.krosdoplnky.sk/auth/sso/callback
AUTH_SERVICE_APP_KEY=financie
KROS_API_BASE=https://api-economy.kros.sk
PORT=3000
